# Copy this file to .env and adjust as needed.

# Port the web server listens on
PORT=3000

# Secret used to sign session cookies. CHANGE THIS to a long random string in production.
SESSION_SECRET=change-this-to-a-long-random-string

# Default admin account created the first time the app starts with an empty database.
# CHANGE THE PASSWORD after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# A visit still "checked in" after this many hours is flagged as overdue on the dashboard.
OVERDUE_HOURS=6
