# Copy this file to .env and adjust as needed.

# Port the web server listens on
PORT=3000

# Secret used to sign session cookies. CHANGE THIS to a long random string in production.
SESSION_SECRET=change-this-to-a-long-random-string

# Shared front-desk passcode. Whoever knows this can check visitors in/out.
# CHANGE THIS before deploying - anyone at the desk needs to know it, but it
# should not be guessable.
ACCESS_PASSCODE=change-this-passcode

# A visit still "checked in" after this many hours is flagged as overdue on the dashboard.
OVERDUE_HOURS=6
